# Meaningless Charts — fetcher API keys
#
# These are only needed for the keyed data sources (BLS, OpenAQ). The four
# keyless sources (World Bank, NASA POWER, USGS, Wikimedia Pageviews) work
# without any of this. Never commit a real key — copy this file to .env and
# fill in real values there.

# Register at https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Register at https://explore.openaq.org/register
OPENAQ_API_KEY=
