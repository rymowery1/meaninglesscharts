---
import type { GeneratedChart } from "../data/types";
import DatasetBadge from "./DatasetBadge.astro";

interface Props {
  chart: GeneratedChart;
}
const { chart } = Astro.props;

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// Formats a "YYYY-MM-DD" string directly, without going through Date/local
// timezone conversion — parsing an ISO date via `new Date()` and formatting
// with toLocaleDateString shifts the displayed day back by one in any
// timezone behind UTC (e.g. "1960-01-01" renders as "Dec 31, 1959").
function fmtDate(iso: string): string {
  const [year, month, day] = iso.split("-").map(Number);
  return `${MONTHS[month - 1]} ${day}, ${year}`;
}
function fmtNum(n: number): string {
  return n.toLocaleString("en-US", { maximumFractionDigits: 2 });
}

const first = chart.points[0];
const last = chart.points[chart.points.length - 1];
---
<section class="source-panel" aria-label="Chart sources and methodology">
  <details>
    <summary>
      <span class="source-panel-title">Sources</span>
      <span class="source-summary-badges">
        <DatasetBadge domain={chart.datasetA.domain} />
        <DatasetBadge domain={chart.datasetB.domain} />
      </span>
    </summary>
    <div class="source-panel-grid">
      <div class="source-entry">
        <p class="source-label">{chart.datasetA.label}</p>
        <dl>
          <dt>Source</dt>
          <dd><a href={chart.datasetA.sourceUrl} rel="noopener noreferrer">{chart.datasetA.sourceOrganization}</a></dd>
          <dt>Geography</dt>
          <dd>{chart.datasetA.geography}</dd>
          <dt>Unit</dt>
          <dd>{chart.datasetA.unit}</dd>
          <dt>Full date range</dt>
          <dd>{fmtDate(chart.datasetA.dateRange.start as string)} – {fmtDate(chart.datasetA.dateRange.end as string)}</dd>
          <dt>Baseline value ({fmtDate(chart.normalizationBaselineDate)})</dt>
          <dd>{fmtNum(first.aOriginal)} {chart.datasetA.unit}</dd>
        </dl>
      </div>
      <div class="source-entry">
        <p class="source-label">{chart.datasetB.label}</p>
        <dl>
          <dt>Source</dt>
          <dd><a href={chart.datasetB.sourceUrl} rel="noopener noreferrer">{chart.datasetB.sourceOrganization}</a></dd>
          <dt>Geography</dt>
          <dd>{chart.datasetB.geography}</dd>
          <dt>Unit</dt>
          <dd>{chart.datasetB.unit}</dd>
          <dt>Full date range</dt>
          <dd>{fmtDate(chart.datasetB.dateRange.start as string)} – {fmtDate(chart.datasetB.dateRange.end as string)}</dd>
          <dt>Baseline value ({fmtDate(chart.normalizationBaselineDate)})</dt>
          <dd>{fmtNum(first.bOriginal)} {chart.datasetB.unit}</dd>
        </dl>
      </div>
    </div>

    <dl class="chart-meta">
      <dt>Normalization</dt>
      <dd>{chart.normalization}, at {fmtDate(chart.normalizationBaselineDate)}</dd>
      <dt>Shared window shown</dt>
      <dd>{fmtDate(first.date)} – {fmtDate(last.date)} ({chart.points.length} points, {chart.datasetA.frequency})</dd>
    </dl>
  </details>

  <p class="disclaimer">{chart.disclaimer}</p>
</section>

<style>
  .source-panel {
    font-family: var(--font-sans);
    font-size: var(--text-body-sans-s-size);
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    margin-top: 1.5rem;
  }
  .source-panel summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .source-panel-title {
    font-family: var(--font-sans);
    font-size: var(--text-label-size);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .source-summary-badges {
    display: flex;
    gap: 0.4rem;
  }
  .source-panel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  @media (min-width: 40rem) {
    .source-panel-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .source-label {
    font-family: var(--font-serif);
    font-size: var(--text-serif-m-size);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.75rem;
  }
  dt {
    color: var(--color-muted);
  }
  dd {
    margin: 0;
  }
  .chart-meta {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-border);
  }
  .disclaimer {
    margin-top: 1rem;
    font-style: italic;
    color: var(--color-muted);
  }
</style>
